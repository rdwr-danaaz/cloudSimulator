__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- Office lock/temp files ---
~$*.docx
~$*.doc
~$*.xlsx

# --- Editor / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

