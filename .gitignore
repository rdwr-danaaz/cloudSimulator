# --- Secrets / machine-specific config (DO NOT COMMIT) ---
# Real installer config holds SSH credentials & truststore password.
# Commit deploy/install_config.example.json instead.
deploy/install_config.json

# Private TLS key for the self-signed simulator cert.
# The Docker build regenerates a cert if certs/ is missing.
certs/server.key
certs/*.key

# --- Logs ---
*.log
ade_log.txt

